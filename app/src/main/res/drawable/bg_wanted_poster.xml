<?xml version="1.0" encoding="utf-8"?>
<!-- Papel envelhecido com moldura dupla, no estilo dos cartazes de recompensa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/parchment" />
            <stroke
                android:width="3dp"
                android:color="@color/wood_brown" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/wood_brown" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
