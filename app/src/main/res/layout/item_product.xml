<?xml version="1.0" encoding="utf-8"?>
<!-- Item da lista de produtos (RecyclerView). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/parchment"
    app:cardCornerRadius="@dimen/corner_card"
    app:cardElevation="2dp"
    app:strokeColor="@color/wood_brown"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="@dimen/product_thumbnail_size"
            android:layout_height="@dimen/product_thumbnail_size"
            android:background="@drawable/bg_image_frame"
            android:clipToOutline="true"
            android:padding="2dp">

            <ImageView
                android:id="@+id/ivProductIcon"
                android:layout_width="@dimen/product_thumbnail_icon_size"
                android:layout_height="@dimen/product_thumbnail_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_figure" />

            <TextView
                android:id="@+id/tvDiscountBadge"
                style="@style/Widget.GrandLine.DiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/spacing_xsmall"
                android:visibility="gone"
                tools:text="-12%"
                tools:visibility="visible" />
        </FrameLayout>

        <Space
            android:layout_width="@dimen/spacing_medium"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GrandLine.SectionLabel"
                tools:text="Figures" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/ink"
                android:textStyle="bold"
                tools:text="Figure Monkey D. Luffy – Gear 5" />

            <TextView
                android:id="@+id/tvCharacter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/wood_brown"
                android:visibility="gone"
                tools:text="Personagem: Monkey D. Luffy"
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/spacing_xsmall" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textAppearance="@style/TextAppearance.GrandLine.OriginalPrice"
                    android:visibility="gone"
                    tools:text="R$ 549,90"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GrandLine.Price"
                    tools:text="R$ 479,90" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold"
                tools:text="Últimas 2 unidades!"
                tools:textColor="@color/stock_low" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
